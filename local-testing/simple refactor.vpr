function make_generic_s_Ref_mutable(
  self: s_Ref_mutable
): s_Param
  ensures (typ(result)) == (s_Ref_mutable_type(s_Ref_mutable_typaram_T(typeof_s_Ref_mutable(self))))
  ensures (make_concrete_s_Ref_mutable(result, s_Ref_mutable_typaram_T(typeof_s_Ref_mutable(self)))) == (self)

function make_concrete_s_Ref_mutable(
  snap: s_Param,
  T: Type
): s_Ref_mutable
  ensures (make_generic_s_Ref_mutable(result)) == (snap)

