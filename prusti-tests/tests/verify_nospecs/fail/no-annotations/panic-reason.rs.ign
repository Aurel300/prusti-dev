macro_rules! inner_unreachable {
    () => {
        {
            unreachable!();  // ERRXR: unreachable!(..) statement might be reachable
        }
    };
}

fn test_inner_unreachable(x: bool) {
    inner_unreachable!();
}

macro_rules! inner_unimplemented {
    () => {
        {
            /*unimplemented!()*/;  // ERRXR: unimplemented!(..) statement might be reachable
        }
    };
}

fn test_inner_unimplemented(x: bool) {
