/*use prusti_contracts::*;*/

/*#[pure]*/
fn fib(n: isize) -> isize {
    if n <= 1 {
        1
    } else {
        fib(n-1) + fib(n-2)
    }
}

pub fn test1() {
    // Each call unrolls the function. Hence all assertions pass.
    /*assert*/drop(fib(0) == 1);
    /*assert*/drop(fib(1) == 1);
    /*assert*/drop(fib(2) == 2);
    /*assert*/drop(fib(3) == 3);
    /*assert*/drop(fib(4) == 5);
}

pub fn test2() {
    // We unroll the function at most once, hence this fails.
    /*assert*/drop(fib(4) == 5);   // ERRXR: the asserted expression might not hold
}

/*#[pure]*/
fn dummy(_n: isize, _res: isize) -> bool { true }

#[requires(
    // This is an unsound quantifier to check whether triggerring works.
    forall(|n: isize, res: isize| fib(n) == res, triggers=[(dummy(n, res),)])
)]
pub fn test3() {
    dummy(4, 5);
    /*assert*/drop(fib(4) == 5);
}

fn main() {}
