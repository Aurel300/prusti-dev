/*use prusti_contracts::*;*/

#[requires({
    /*assert*/drop(x != 0);
    true
})]
fn foo(x: u32) {
    /*assert*/drop(x != 0); // OK
    /*assert*/drop(false);  // ERRXR: the asserted expression might not hold
}

fn bad(x: u32) {
    foo(x); // ERRXR: precondition might not hold
}

fn main() {
    foo(1); // OK
}
