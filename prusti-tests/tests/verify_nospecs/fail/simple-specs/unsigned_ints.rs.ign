/*use prusti_contracts::*;*/

/*#[pure]*/
/*#[trusted]*/
fn get_usize() -> usize {
    /*unimplemented!()*/;0
}

/*#[pure]*/
/*#[trusted]*/
fn get_u32() -> u32 {
    /*unimplemented!()*/;0
}

/*#[pure]*/
/*#[trusted]*/
fn get_i32() -> i32 {
    /*unimplemented!()*/;0
}

fn test1() {
    /*assert*/drop(get_usize() >= 0);
    /*assert*/drop(get_u32() >= 0);
    /*assert*/drop(get_i32() >= 0);    // ERRXR: the asserted expression might not hold
}

fn test2() {
    /*assert*/drop(get_usize() >= 1);  // ERRXR: the asserted expression might not hold
}

fn test3(x: usize, y: u32, z: i32) {
    /*assert*/drop(x >= 0);
    /*assert*/drop(y >= 0);
    /*assert*/drop(z >= 0);    // ERRXR: the asserted expression might not hold
}

fn test4(x: usize) {
    /*assert*/drop(x >= 1);  // ERRXR: the asserted expression might not hold
}

fn test5(x: usize) {
    test4(4 - x);  // ERRXR: type invariant expected by the function call might not hold.
}

fn main() {}
