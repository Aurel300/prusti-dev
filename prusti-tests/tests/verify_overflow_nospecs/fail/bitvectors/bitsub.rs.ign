
/*use prusti_contracts::*;*/

fn bitsub_1() {
    let a = 1u8;
    let b = a | 8;
    let c = b - 4;
    /*assert*/drop(c == 5);
}

fn bitsub_2() {
    let a = 1u8;
    let b = a | 2;
    let c = b - 4;
    /*assert*/drop(c == 8);    // ERRXR: the asserted expression might not hold
}

fn main() {}

