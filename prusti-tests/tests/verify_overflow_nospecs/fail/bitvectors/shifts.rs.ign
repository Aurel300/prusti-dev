
/*use prusti_contracts::*;*/

fn shift_left_1() {
    let a = 1u8;
    let b = a << 2;
    /*assert*/drop(b == 4);
}

fn shift_left_2() {
    let a = 1u8;
    let b = a << 2;
    /*assert*/drop(b == 8);    // ERRXR: the asserted expression might not hold
}

fn shift_left_3() {
    let a = 1u8;
    let _b = a << 8;    // ERRXR: assertion might fail with "attempt to shift left with overflow"
}

fn shift_unsigned_right_1() {
    let a = 4u8;
    let b = a >> 2;
    /*assert*/drop(b == 1);
}

fn shift_unsigned_right_2() {
    let a = 4u8;
    let b = a >> 2;
    /*assert*/drop(b == 2);    // ERRXR: the asserted expression might not hold
}

fn shift_unsigned_right_3() {
    let a = 4u8;
    let b = a >> 9;     // ERRXR: assertion might fail with "attempt to shift right with overflow"
}

fn shift_unsigned_right_4() {
    let a = 255u8;
    let b = a >> 2;
    /*assert*/drop(b == 63);
}

fn shift_signed_right_1() {
    let a = -1i8;
    let b = a >> 2;
    /*assert*/drop(b == -1);
}

fn shift_signed_right_2() {
    let a = -1i8;
    let b = a >> 2;
    /*assert*/drop(b == -2);   // ERRXR: the asserted expression might not hold
}

fn shift_signed_right_3() {
    let a = -1i8;
    let b = a >> 9;     // ERRXR: assertion might fail with "attempt to shift right with overflow"
}

fn shift_signed_right_4() {
    let a = 4i8;
    let b = a >> 2;
    /*assert*/drop(b == 1);
}

fn main() {}
