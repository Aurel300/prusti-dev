
/*use prusti_contracts::*;*/

fn test1() {
    let a = 1;
    let b = 2;
    let c = a + b;
    /*assert*/drop(c == 3);
}

fn test2() {
    let a = 1;
    let b = 2;
    let c = a + b;
    /*assert*/drop(c == 4);    // ERRXR: the asserted expression might not hold
}

fn test3(a: i32, b: i32) -> i32 {
    a + b   // ERRXR: assertion might fail with "attempt to add with overflow"
}

fn test4() {
    let x = 1 / 3;
    /*assert*/drop(x == 0);
    let x = 4 / 3;
    /*assert*/drop(x == 1);
}

fn test5() {
    let x = 1 / 3;
    /*assert*/drop(x == 1);    // ERRXR: the asserted expression might not hold
}

fn test6() {
    let x = 1 * 3;
    /*assert*/drop(x == 3);
}

fn test7() {
    let x = 1 * 3;
    /*assert*/drop(x == 1);    // ERRXR: the asserted expression might not hold
}

fn main() {}
