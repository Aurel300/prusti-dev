
/*use prusti_contracts::*;*/

fn test1() {
    let a = [1, 2];
}

fn test2() {
    let a = [1, 2];
    /*assert*/drop(false);     // ERRXR: the asserted expression might not hold
}

fn test3() {
    let a = [1; 100];
}

fn test4() {
    let a = [1; 100];
    let b = a[1];
    /*assert*/drop(b == 1);
}

fn test5() {
    let a = [1; 100];
    let b = a[1];
    /*assert*/drop(b == 6);     // ERRXR: the asserted expression might not hold
}

fn test6() {
    let a = [1; 100];
    let b = a[1];
    let c = a[2];
    /*assert*/drop(b == 1);
    /*assert*/drop(c == 1);
}

fn test7() {
    let a = [1; 100];
    let b = a[1];
    let c = a[2];
    /*assert*/drop(b == 1);
    /*assert*/drop(c == 2);     // ERRXR: the asserted expression might not hold
}

fn test10() {
    let mut a = [1; 100];
    a[1] = 2;
    /*prusti_assert*/drop(a[1] == 2);
    /*prusti_assert*/drop(a[0] == 1);
    /*prusti_assert*/drop(a[2] == 1);
    /*prusti_assert*/drop(a[3] == 1);
    /*prusti_assert*/drop(a[4] == 1);
    /*prusti_assert*/drop(a[5] == 1);
    /*prusti_assert*/drop(a[6] == 1);
    /*prusti_assert*/drop(a[7] == 1);
    /*prusti_assert*/drop(a[8] == 1);
    /*prusti_assert*/drop(a[9] == 1);
    /*prusti_assert*/drop(a[10] == 1);
}

fn test11() {
    let mut a = [1; 100];
    a[1] = 2;
    /*prusti_assert*/drop(a[1] == 2);
    /*prusti_assert*/drop(a[0] == 1);
    /*prusti_assert*/drop(a[2] == 1);
    /*prusti_assert*/drop(a[3] == 1);
    /*prusti_assert*/drop(a[4] == 1);
    /*prusti_assert*/drop(a[5] == 1);
    /*prusti_assert*/drop(a[0] == 2);     // ERRXR: the asserted expression might not hold
}

