
#![allow(unused)]

/*use prusti_contracts::*;*/

fn empty_ghost_block() {
    ghost! {}
}

fn return_disallowed() {
    ghost! {
        return; // ERRXR: Can't leave the ghost block early
    }
}

fn break_disallowed() {
    while true {
        ghost! {
            break; // ERRXR: Can't leave the ghost block early
        }
    }
}

fn continue_disallowed(x: bool) {
    while true {
        ghost! {
            if x {
                continue; // ERRXR: Can't leave the ghost block early
            } else {
                continue; // ERRXR: Can't leave the ghost block early
            }
        }
    }
}

fn inner_loop_breaks_allowed() {
    ghost! {
        while true {
            break;
            continue;
        }
    }
}

fn inner_labeled_loop_allowed() {
    ghost! {
        'inner: while true {
            break;
        }
    }
}

fn cannot_break_outer_labeled_loop() {
    'outer: while true {
        ghost! {
            while true {
                continue 'outer; // ERRXR: Can't leave the ghost block early
                break;
            }
        }
    }
}

fn main() {}
