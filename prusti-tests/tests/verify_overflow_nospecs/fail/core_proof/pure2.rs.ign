// This test is executed only with Silicon because we have a matching
// loop that gets triggered by Carbon.

/*use prusti_contracts::*;*/

/*#[pure]*/
/*#[requires(n >= 0)]*/
/*#[ensures(result <= n)]*/
#[terminates(Int::new_usize(n))]
fn count(n: usize) -> usize {
    if n == 0 { 0 }
    else { count(n-1) + 1 }
}

