
/*use prusti_contracts::*;*/

/*#[pure]*/
#[terminates]
fn tuple1() -> (i32, i32) {
    (1, 2)
}

/*#[requires(tuple1() == tuple1())]*/
fn test1() {}

fn test2() {
    test1();
}

/*#[pure]*/
#[terminates]
fn first(x: (i32, i32)) -> i32 {
    x.0
}

/*#[requires(first(tuple1()) == tuple1().0)]*/
fn test3() { }

fn test4() {
    test3();
}

/*#[requires(first(tuple1()) == tuple1().1)]*/
fn test5() { }

fn test6() {
    test5();    // ERRXR: precondition might not hold
}

/*#[requires(first(t) == tuple1().1)]*/
fn test7(t: (i32, i32)) { }

fn test8() {
    let a = (2, 4);
    test7(a);
}

fn test9() {
    let a = (3, 4);
    test7(a);    // ERRXR: precondition might not hold
}

fn main() {}
