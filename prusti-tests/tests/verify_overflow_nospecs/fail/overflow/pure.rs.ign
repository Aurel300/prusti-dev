/*use prusti_contracts::*;*/

/*#[pure]*/
fn sum_pure(a: u32, b: u32) -> u32 {
    a + b // ERRXR
}

/*#[trusted]*/
/*#[pure]*/
fn u32_foo() -> u32 {
    5
}

fn u32_foo_call_1() {
    let n = u32_foo();
    /*assert*/drop(0 <= n);
    /*assert*/drop(n <= 4294967295);
    /*assert*/drop(n == 5); // ERRXR
}

fn u32_foo_call_2() {
    /*assert*/drop(0 <= u32_foo());
    /*assert*/drop(u32_foo() <= 4294967295);
    /*assert*/drop(u32_foo() == 5); // ERRXR
}

/*#[ensures(0 <= u32_foo() && u32_foo() <= 4294967295)]*/
/*#[ensures(u32_foo() == 5)]*/ // ERRXR
fn u32_foo_call_3() {
}

fn main() {}

